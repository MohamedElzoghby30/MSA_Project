@model List<UserEditDto>
@{ViewData["Title"]="Users";}<div class="page-head"><div><h2>Users</h2><p>Manage administrator accounts.</p></div><a class="btn btn-primary" asp-action="Create">+ New User</a></div><div class="table-wrap"><table class="table"><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var u in Model){<tr><td><strong>@u.FullName</strong><div style="color:#91a1b5">@u.Email</div></td><td>@u.Role</td><td><span class="badge @(u.IsActive?"badge-success":"badge-muted")">@(u.IsActive?"Active":"Disabled")</span></td><td><a class="btn btn-ghost" asp-action="Edit" asp-route-id="@u.Id">Edit</a><form asp-action="Delete" method="post" style="display:inline"><input type="hidden" name="id" value="@u.Id"/><button class="btn btn-danger">Delete</button></form></td></tr>}</tbody></table></div>
