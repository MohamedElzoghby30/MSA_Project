@model DashboardDto
@{ViewData["Title"]="Dashboard";var maxV=Math.Max(1,Model.VisitorTrend.Max(x=>x.Value));}
<div class="page-head"><div><h2>Overview</h2><p>Monitor your website at a glance.</p></div><a class="btn btn-ghost" href="/">View Website ↗</a></div>
<div class="stats-grid"><div class="stat-card"><div class="stat-icon">◉</div><div class="stat-info"><span>Total Visitors</span><strong>@Model.Stats.Visitors</strong><small>All time</small></div></div><div class="stat-card"><div class="stat-icon">▥</div><div class="stat-info"><span>Page Views</span><strong>@Model.Stats.PageViews</strong><small>All time</small></div></div><div class="stat-card"><div class="stat-icon">◈</div><div class="stat-info"><span>Products</span><strong>@Model.Stats.Products</strong><small>Active</small></div></div><div class="stat-card"><div class="stat-icon">✦</div><div class="stat-info"><span>Services</span><strong>@Model.Stats.Services</strong><small>Active</small></div></div><div class="stat-card"><div class="stat-icon">✉</div><div class="stat-info"><span>Unread Messages</span><strong>@Model.Stats.UnreadMessages</strong><small>Needs attention</small></div></div><div class="stat-card"><div class="stat-icon">▤</div><div class="stat-info"><span>Published Pages</span><strong>@Model.Stats.PublishedPages</strong><small>Live pages</small></div></div></div>
<div class="dashboard-grid"><div class="card dashboard-card"><div class="page-head" style="margin-bottom:0"><div><span class="detail-label">Last 30 Days</span><h3 style="margin:5px 0 0;font:600 17px Poppins">Visitor Trend</h3></div></div><div class="chart">@foreach(var p in Model.VisitorTrend){<div class="bar" style="height:@Math.Max(4,(p.Value*100/maxV))%" title="@p.Label: @p.Value"></div>}</div></div><div class="card dashboard-card"><div class="page-head" style="margin-bottom:0"><div><span class="detail-label">Activity</span><h3 style="margin:5px 0 0;font:600 17px Poppins">Recent Messages</h3></div><a asp-controller="Messages" asp-action="Index">View all</a></div><div class="recent-list">@if(!Model.RecentMessages.Any()){<div class="empty">No messages yet.</div>}else{foreach(var m in Model.RecentMessages){<a style="text-decoration:none;color:inherit" asp-controller="Messages" asp-action="Details" asp-route-id="@m.Id"><div class="recent-item"><strong>@m.Name · @m.Subject</strong><span>@m.MessageType · @m.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span></div></a>}}</div></div></div>
