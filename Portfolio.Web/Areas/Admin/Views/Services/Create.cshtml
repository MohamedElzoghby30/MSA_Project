@model ServiceFormModel
@{ViewData["Title"]="Create Service";}<div class="page-head"><div><h2>Create Service</h2><p>Add a service.</p></div></div><form asp-action="Create" method="post" enctype="multipart/form-data" class="card"><div class="form-grid"><div class="form-group"><label asp-for="Title">Title</label><input asp-for="Title" class="input" required/></div><div class="form-group"><label asp-for="Icon">Icon Key</label><input asp-for="Icon" class="input" placeholder="code, star, shield..."/></div><div class="form-group"><label asp-for="SortOrder">Sort Order</label><input asp-for="SortOrder" class="input" type="number"/></div><div class="form-group"><label>Image</label><input asp-for="ImageFile" class="input" type="file" accept="image/*"/></div><div class="form-group full"><label asp-for="Description">Description</label><textarea asp-for="Description" class="textarea"></textarea></div><label class="check-row"><input asp-for="IsActive"/> Active</label></div><div class="actions"><button class="btn btn-primary">Create Service</button><a class="btn btn-ghost" asp-action="Index">Cancel</a></div></form>
