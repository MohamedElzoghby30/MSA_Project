@model List<ServiceDto>
@{ViewData["Title"]="Services";}<div class="page-head"><div><h2>Services</h2><p>Manage services shown on the public website.</p></div><a class="btn btn-primary" asp-action="Create">+ New Service</a></div><div class="table-wrap"><table class="table"><thead><tr><th>Title</th><th>Image</th><th>Status</th><th>Order</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="5" class="empty">No services yet.</td></tr>}@foreach(var s in Model){<tr><td><strong>@s.Title</strong><div style="color:#91a1b5;margin-top:3px">@s.Description</div></td><td>@if(s.Image is not null){<img src="@s.Image" class="image-thumb"/>}</td><td><span class="badge @(s.IsActive?"badge-success":"badge-muted")">@(s.IsActive?"Active":"Inactive")</span></td><td>@s.SortOrder</td><td><a class="btn btn-ghost" asp-action="Edit" asp-route-id="@s.Id">Edit</a><form asp-action="Delete" method="post" style="display:inline"><input type="hidden" name="id" value="@s.Id"/><button class="btn btn-danger">Delete</button></form></td></tr>}</tbody></table></div>
