@model ServiceDto
@{ViewData["Title"]="Edit Service";}<div class="page-head"><div><h2>Edit Service</h2><p>Update service information.</p></div></div><form asp-action="Edit" method="post" enctype="multipart/form-data" class="card"><input asp-for="Id" type="hidden"/><div class="form-grid"><div class="form-group"><label asp-for="Title">Title</label><input asp-for="Title" class="input"/></div><div class="form-group"><label asp-for="Icon">Icon Key</label><input asp-for="Icon" class="input"/></div><div class="form-group"><label asp-for="SortOrder">Sort Order</label><input asp-for="SortOrder" class="input" type="number"/></div><div class="form-group"><label>Replace Image</label><input name="ImageFile" class="input" type="file" accept="image/*"/>@if(Model.Image is not null){<img src="@Model.Image" class="image-thumb" style="margin-top:8px"/>}</div><div class="form-group full"><label asp-for="Description">Description</label><textarea asp-for="Description" class="textarea"></textarea></div><label class="check-row"><input asp-for="IsActive"/> Active</label></div><div class="actions"><button class="btn btn-primary">Save Changes</button><a class="btn btn-ghost" asp-action="Index">Cancel</a></div></form>
