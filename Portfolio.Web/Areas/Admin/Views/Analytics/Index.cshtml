@model AnalyticsDto
@{ViewData["Title"]="Analytics";var max=Math.Max(1,Model.Trend.Max(x=>x.Value));}<div class="page-head"><div><h2>Analytics</h2><p>First-party website traffic for the last 30 days.</p></div></div><div class="stats-grid"><div class="stat-card"><div class="stat-icon">◉</div><div class="stat-info"><span>Unique Visitors</span><strong>@Model.UniqueVisitors</strong></div></div><div class="stat-card"><div class="stat-icon">▥</div><div class="stat-info"><span>Page Views</span><strong>@Model.PageViews</strong></div></div></div><div class="dashboard-grid"><div class="card dashboard-card"><span class="detail-label">PAGE VIEWS</span><h3 style="margin:5px 0 0;font:600 17px Poppins">Traffic Trend</h3><div class="chart">@foreach(var p in Model.Trend){<div class="bar" style="height:@Math.Max(4,p.Value*100/max)%" title="@p.Label: @p.Value"></div>}</div></div><div class="card"><span class="detail-label">TOP PAGES</span><h3 style="margin:5px 0 15px;font:600 17px Poppins">Popular URLs</h3>@if(!Model.PopularPages.Any()){<div class="empty">No traffic yet.</div>}else{foreach(var p in Model.PopularPages){<div class="section-row"><div class="grow"><strong>@p.Item1</strong><small>@p.Item2 views</small></div></div>}}</div></div>
