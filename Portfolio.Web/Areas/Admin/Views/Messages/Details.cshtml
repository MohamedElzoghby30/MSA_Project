@model MessageDto
@{ViewData["Title"]="Message Details";}<div class="page-head"><div><h2>Message</h2><p>@Model.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy HH:mm")</p></div><a class="btn btn-ghost" asp-action="Index">Back</a></div><div class="card"><div class="detail-grid"><div><span class="detail-label">Name</span><div class="detail-value">@Model.Name</div></div><div><span class="detail-label">Email</span><div class="detail-value">@Model.Email</div></div><div><span class="detail-label">Phone</span><div class="detail-value">@Model.Phone</div></div><div><span class="detail-label">Country</span><div class="detail-value">@Model.Country</div></div><div><span class="detail-label">Type</span><div class="detail-value">@Model.MessageType</div></div><div><span class="detail-label">Subject</span><div class="detail-value">@Model.Subject</div></div></div><hr style="border-color:rgba(255,255,255,.06);margin:22px 0"/><span class="detail-label">Message</span><div style="margin-top:8px;line-height:1.8;color:#d7dfeb;white-space:pre-wrap">@Model.Message</div><div class="actions"><form asp-action="ToggleReplied" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-primary">@(Model.IsReplied?"Mark as Not Replied":"Mark as Replied")</button></form><form asp-action="ToggleRead" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-ghost">@(Model.IsRead?"Mark Unread":"Mark Read")</button></form><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-danger">Delete</button></form></div></div>
