@model List<MessageDto>
@{ViewData["Title"]="Messages";}<div class="page-head"><div><h2>Messages</h2><p>Review contact inquiries and complaints.</p></div><a class="btn btn-ghost" asp-action="Index" asp-route-archived="true">Archived</a></div><div class="table-wrap"><table class="table"><thead><tr><th>Sender</th><th>Subject</th><th>Type</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="empty">No messages found.</td></tr>}@foreach(var m in Model){<tr><td><strong>@m.Name</strong><div style="color:#91a1b5">@m.Email</div></td><td>@m.Subject</td><td>@m.MessageType</td><td>@m.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td><td><span class="badge @(m.IsRead?"badge-muted":"badge-gold")">@(m.IsRead?"Read":"Unread")</span> <span class="badge @(m.IsReplied?"badge-success":"badge-muted")">@(m.IsReplied?"Replied":"Open")</span></td><td><a class="btn btn-ghost" asp-action="Details" asp-route-id="@m.Id">View</a><form asp-action="ToggleRead" method="post" style="display:inline"><input type="hidden" name="id" value="@m.Id"/><button class="btn btn-ghost">Read</button></form><form asp-action="Archive" method="post" style="display:inline"><input type="hidden" name="id" value="@m.Id"/><button class="btn btn-danger">Archive</button></form></td></tr>}</tbody></table></div>
