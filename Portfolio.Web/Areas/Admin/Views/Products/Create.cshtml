@model ProductFormModel
@{ViewData["Title"]="Create Product";}<div class="page-head"><div><h2>Create Product</h2><p>Add a new product to your portfolio.</p></div></div><form asp-action="Create" method="post" class="card"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="form-group"><label asp-for="Name">Name</label><input asp-for="Name" class="input" required/></div><div class="form-group"><label asp-for="Price">Price</label><input asp-for="Price" class="input" type="number" step="0.01"/></div><div class="form-group"><label asp-for="Currency">Currency</label><input asp-for="Currency" class="input" value="USD"/></div><div class="form-group"><label asp-for="SortOrder">Sort Order</label><input asp-for="SortOrder" class="input" type="number" value="0"/></div><div class="form-group full"><label asp-for="Description">Description</label><textarea asp-for="Description" class="textarea"></textarea></div><label class="check-row"><input asp-for="IsActive"/> Active</label></div><div class="actions"><button class="btn btn-primary">Create Product</button><a class="btn btn-ghost" asp-action="Index">Cancel</a></div></form>
