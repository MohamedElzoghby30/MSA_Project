@model List<ProductListDto>
@{ViewData["Title"]="Products";}<div class="page-head"><div><h2>Products</h2><p>Manage products, prices and product galleries.</p></div><a class="btn btn-primary" asp-action="Create">+ New Product</a></div><div class="table-wrap"><table class="table"><thead><tr><th>Product</th><th>Price</th><th>Images</th><th>Status</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="5" class="empty">No products yet.</td></tr>}@foreach(var p in Model){<tr><td><div style="display:flex;align-items:center;gap:10px">@if(p.MainImage is not null){<img class="image-thumb" src="@p.MainImage"/>}<strong>@p.Name</strong></div></td><td>@(p.Price > 0 ? p.Price.ToString("N2") + " " + p.Currency : "Price on request")</td><td>@p.ImageCount</td><td><span class="badge @(p.IsActive?"badge-success":"badge-muted")">@(p.IsActive?"Active":"Inactive")</span></td><td><a class="btn btn-ghost" asp-action="Edit" asp-route-id="@p.Id">Edit</a> <a class="btn btn-ghost" asp-action="Images" asp-route-id="@p.Id">Images</a> <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display:inline"><button class="btn btn-danger" onclick="return confirm('Delete this product?')">Delete</button></form></td></tr>}</tbody></table></div>
