@model RoleEditDto
@{ViewData["Title"]="Edit Role";var ps=ViewBag.Permissions as List<(Guid Id,string Name)>??[];}<div class="page-head"><div><h2>Edit Role</h2><p>Assign permissions to @Model.Name.</p></div></div><form asp-action="Edit" method="post" class="card"><input asp-for="Id" type="hidden"/><div class="form-grid"><div class="form-group"><label>Name</label><input asp-for="Name" class="input"/></div><div class="form-group"><label>Description</label><input asp-for="Description" class="input"/></div></div><div style="margin-top:20px"><span class="detail-label">Permissions</span><div class="form-grid" style="margin-top:10px">@foreach(var p in ps){<label class="check-row"><input type="checkbox" name="PermissionIds" value="@p.Id" @(Model.PermissionIds.Contains(p.Id) ? "checked" : "")/> @p.Name</label>}</div></div><div class="actions"><button class="btn btn-primary">Save Role</button><a class="btn btn-ghost" asp-action="Index">Cancel</a></div></form>
