@model List<RoleEditDto>
@{ViewData["Title"]="Roles & Permissions";}<div class="page-head"><div><h2>Roles & Permissions</h2><p>Control access using reusable permission sets.</p></div><a class="btn btn-primary" asp-action="Create">+ New Role</a></div><div class="table-wrap"><table class="table"><thead><tr><th>Role</th><th>Description</th><th>Actions</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><strong>@r.Name</strong></td><td>@r.Description</td><td><a class="btn btn-ghost" asp-action="Edit" asp-route-id="@r.Id">Edit Permissions</a><form asp-action="Delete" method="post" style="display:inline"><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-danger">Delete</button></form></td></tr>}</tbody></table></div>
